# Jarvis environment. Copy to .env and fill in.

# ---- LLM provider ----
#   minimax   -> MiniMax API (https://api.minimaxi.com/v1), MiniMax token plan
#   bailian   -> Bailian/QwenCloud token plan (from ~/.config/kilo/kilo.jsonc)
JARVIS_PROVIDER=minimax

# MiniMax (default provider)
JARVIS_MINIMAX_BASE_URL=https://api.minimax.io/v1
JARVIS_MINIMAX_API_KEY=REPLACE_ME
JARVIS_MINIMAX_MODEL=MiniMax-M3
JARVIS_MINIMAX_SMALL_MODEL=MiniMax-M2.7-highspeed
JARVIS_MINIMAX_THINKING=disabled

# Bailian (alternative; endpoint+key read from kilo.jsonc if omitted)
# JARVIS_BAILIAN_BASE_URL=https://token-plan.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
# JARVIS_BAILIAN_API_KEY=sk-sp-...
# JARVIS_BAILIAN_MODEL=qwen3.8-max
# JARVIS_BAILIAN_SMALL_MODEL=qwen3.7-plus

# ---- Whisper (local STT) ----
# Backend: faster_whisper (CPU/CUDA) | mlx_whisper (Apple Silicon GPU, py3.10+)
JARVIS_STT_BACKEND=mlx_whisper
JARVIS_WHISPER_MODEL=mlx-community/whisper-large-v3-turbo
JARVIS_WHISPER_DEVICE=auto
JARVIS_WHISPER_COMPUTE=int8
HF_ENDPOINT=https://hf-mirror.com

# ---- TTS ----
# Backends: edge (best Serbian, MS neural, needs internet) | piper (offline, robotic) |
#           xtts (English only) | azure (MS Speech REST) | elevenlabs (premium multilingual)
#           say (macOS Siri, offline)
JARVIS_TTS_BACKEND=edge
JARVIS_EDGE_VOICE=sr-RS-NicholasNeural
JARVIS_EDGE_RATE=+0%
JARVIS_PIPER_VOICE=sr_RS-serbski_institut-medium
JARVIS_PIPER_LENGTH_SCALE=1.0
JARVIS_SAY_VOICE=Lana
# Azure Speech (F0 free tier: 500k chars/month). Get key from
# https://portal.azure.com -> Speech service -> Keys and Endpoint
# JARVIS_AZURE_SPEECH_KEY=
JARVIS_AZURE_SPEECH_REGION=eastasia
JARVIS_AZURE_SPEECH_VOICE=sr-Latn-RS-NicholasNeural
# ElevenLabs (premium multilingual via eleven_multilingual_v2; supports sr)
# Get API key from https://elevenlabs.io -> Profile -> API Key
# JARVIS_ELEVENLABS_API_KEY=
JARVIS_ELEVENLABS_VOICE=JBFqnCBsd6RMkjVDRZzb
JARVIS_ELEVENLABS_MODEL=eleven_multilingual_v2
JARVIS_ELEVENLABS_FORMAT=mp3_44100_128
# Empty = auto-detect (Language Override OFF). "hr" = closest to sr.
JARVIS_ELEVENLABS_LANGUAGE=
# Voice tuning (ElevenLabs VoiceSettings). 0..1, speed 0.5..2.0
JARVIS_ELEVENLABS_STABILITY=0.5
JARVIS_ELEVENLABS_SIMILARITY=0.75
JARVIS_ELEVENLABS_STYLE=0.0
JARVIS_ELEVENLABS_SPEED=1.0
JARVIS_ELEVENLABS_SPEAKER_BOOST=true
# XTTSv2 (Coqui) - English only, does NOT support Serbian
# JARVIS_TTS_BACKEND=xtts
JARVIS_XTTS_MODEL=tts_models/multilingual/multi-dataset/xtts_v2
JARVIS_XTTS_LANGUAGE=en
JARVIS_XTTS_GPU=true
JARVIS_XTTS_SPEAKER=./data/xtts_ref.wav
# Coqui TTS license auto-agree (non-commercial CPML)
COQUI_TOS_AGREED=1
# TTS playback: ui = browser audio, say = macOS say via server
JARVIS_TTS_OUTPUT=ui

# ---- Server ----
JARVIS_HOST=127.0.0.1
JARVIS_PORT=7777
JARVIS_OPEN_BROWSER=true

# ---- Kilo CLI (terminal/code tasks) ----
JARVIS_KILO_BIN=kilo
JARVIS_KILO_AUTO=true
JARVIS_KILO_CONFIG=./config/kilo-jarvis.jsonc

# ---- Audio ----
JARVIS_HOTKEY=cmd+opt+space
JARVIS_VAD_AGGRESSIVENESS=2
JARVIS_SAMPLE_RATE=16000
JARVIS_SILENCE_MS=900

# ---- Global Push-to-Talk (macOS) ----
# Radi BILO GDE na macOS-u (čak i kad je fokus u drugom app-u), ne samo
# u Jarvis prozoru. Zahteva Accessibility dozvolu (System Settings →
# Privacy & Security → Accessibility).
# Fn se ne može globalno presluškivati na macOS-u; biraj:
#   right cmd, left cmd, right shift, right ctrl, right alt,
#   caps lock, space, tab, f13-f20
JARVIS_PTT_ENABLED=true
JARVIS_PTT_KEY=right cmd
JARVIS_PTT_MUTE=true
JARVIS_PTT_AUTO_SEND=false
JARVIS_PTT_SAMPLE_RATE=16000

# ---- Permissions ----
JARVIS_DEFAULT_POLICY=ask

# ---- Local models (Ollama, optional) ----
# Pipe-separated entries, semicolon-separated models. Each entry:
#   id|ollama_tag|n_ctx|keep_alive
# keep_alive: "5m", "1h", "24h", "-1" forever, "0" evict-on-next-request.
# Zahteva Ollama pokrenut u pozadini (brew services start ollama).
# Modeli se NE učitavaju automatski — biraš ih iz UI-ja (Lokalni modeli tab).
# JARVIS_LOCAL_MODELS=qwen3.6-27b|qwen3.6:27b-mlx|32768|24h;llama-3.1-8b|llama3.1:8b|8192|24h