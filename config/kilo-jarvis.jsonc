{
  "$schema": "https://app.kilo.ai/config.json",
  "_comment": "Restricted profile used by Jarvis when delegating terminal/code tasks to `kilo run --auto`. Anything not explicitly allowed is REJECTED. Edit in the Jarvis UI under 'Dozvole' for live changes.",
  "model": "qwen3.8-max",
  "small_model": "qwen3.7-plus",
  "permission": {
    "bash": {
      "*": "ask",
      "ls *": "allow",
      "ls": "allow",
      "pwd": "allow",
      "echo *": "allow",
      "cat *": "ask",
      "head *": "allow",
      "tail *": "allow",
      "grep *": "allow",
      "rg *": "allow",
      "find *": "ask",
      "git status*": "allow",
      "git log*": "allow",
      "git diff*": "allow",
      "git show*": "allow",
      "git add *": "ask",
      "git commit *": "ask",
      "git checkout *": "ask",
      "git branch *": "ask",
      "npm run *": "ask",
      "pnpm *": "ask",
      "yarn *": "ask",
      "pip install *": "ask",
      "pip3 install *": "ask",
      "python3 *": "ask",
      "mkdir *": "ask",
      "cp *": "ask",
      "mv *": "ask",
      "rm *": "deny",
      "rmdir *": "deny",
      "sudo *": "deny",
      "shutdown *": "deny",
      "reboot *": "deny",
      "defaults *": "deny",
      "osascript *": "ask"
    },
    "edit": "ask",
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "task": "ask",
    "skill": "ask",
    "webfetch": "ask",
    "websearch": "ask",
    "external_directory": "ask"
  },
  "compaction": { "threshold_percent": 60 },
  "watcher": { "ignore": ["**/.venv/**", "**/node_modules/**", "**/.git/**", "**/data/**"] }
}